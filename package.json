{
  "name": "dsh-jev-memory",
  "version": "0.14.0",
  "private": true,
  "description": "Typed, auditable long-term memory for the DeepSeek Harness: a turn-end write hook, a judgement layer (Jev or a deterministic fallback), a local store, and per-session recall injection.",
  "type": "module",
  "exports": {
    ".": "./dsh/index.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "jev",
    "typesafe"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
